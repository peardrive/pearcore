{
  "name": "pearcore",
  "version": "0.1.0",
  "description": "decentralized networking toolkit",
  "type": "module",
  "main": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "migrations"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js run",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test vitest",
    "prepack": "npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [
    "p2p",
    "decentralized",
    "file-sharing",
    "messaging"
  ],
  "author": "Anjou Team",
  "license": "MIT",
  "repository": "https://github.com/peardrive/pearcore/",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.34",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "pear-interface": "^1.1.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "b4a": "^1.7.4",
    "better-sqlite3": "^13.0.3",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "canonicalize": "^5.1.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "hypercore": "^11.28.1",
    "hypercore-protocol": "^8.0.7",
    "hyperdht": "^6.28.0",
    "hyperswarm": "^4.16.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "random-access-memory": "^6.2.1",
    "sqlite3": "^6.0.1"
  }
}

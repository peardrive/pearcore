{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Runtime: Node 22+ with native ESM ("type": "module") */
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    /* Incremental migration: .ts and .js live side by side.
       Flip checkJs to true to type-check the remaining JS via JSDoc. */
    "allowJs": true,
    "checkJs": false,

    /* Type safety */
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,

    /* Module semantics */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* This config only type-checks; tsconfig.build.json emits */
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
